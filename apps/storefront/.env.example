API_URL="http://localhost:4000"
# Secret propio de Auth.js (cifra su cookie de sesión) — independiente de
# AUTH_JWT_SECRET de apps/api. Genera uno con `npx auth secret` o
# `openssl rand -base64 32`.
AUTH_SECRET="changeme"
# Opcional: base para metadataBase/robots.ts/sitemap.ts (SEO). Sin definir,
# next.config.ts ya inyecta la URL real de producción como fallback — solo
# hace falta esta var si el dominio cambia.
# NEXT_PUBLIC_SITE_URL="https://store-demo-storefront-kappa.vercel.app"
