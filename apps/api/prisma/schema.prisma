generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  priceCents  Int
  imageUrl    String
  stock       Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("customer")
  cartItems    CartItem[]
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// userId/guestId son mutuamente excluyentes: un CartItem pertenece a un
// usuario autenticado (userId) o a un carrito de invitado (guestId), nunca a
// ambos ni a ninguno. La invariante se valida en apps/api (Fase 5), no a
// nivel de constraint SQL (SQLite no lo hace cómodo para este alcance).
model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  productId String
  quantity  Int      @default(1)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@unique([guestId, productId])
  @@index([guestId])
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  status     String      @default("pending")
  totalCents Int

  // Dirección de envío embebida (Fase 6, checkout) — campos planos en vez de
  // un modelo Address propio: no hay caso de uso de libreta de direcciones
  // todavía, y SQLite/Prisma no tiene tipos compuestos. Los `@default` no
  // representan datos válidos: existen solo para que la migración pueda
  // añadir estas columnas NOT NULL sobre una tabla `Order` con filas
  // preexistentes (cualquier entorno de desarrollo con seeds de fases
  // anteriores) sin exigir un reset de la base de datos; `checkoutRequestSchema`
  // sigue exigiendo valores no vacíos para cualquier pedido nuevo.
  shippingFullName     String  @default("")
  shippingAddressLine1 String  @default("")
  shippingAddressLine2 String?
  shippingCity         String  @default("")
  shippingPostalCode   String  @default("")
  shippingCountry      String  @default("")
  shippingCents        Int     @default(0)

  // Snapshot explícito de "esta compra pasó por un pago simulado con éxito"
  // (siempre true en la práctica: un pago simulado fallido nunca llega a
  // crear el Order, ver POST /api/orders). Ningún dato de tarjeta se
  // persiste jamás, ni siquiera simulado.
  paymentSimulatedSuccess Boolean @default(true)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
