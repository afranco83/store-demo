    "jose": "6.2.3",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@store-demo/eslint-config": "workspace:*",
    "@store-demo/tsconfig": "workspace:*",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "prisma": "7.8.0",
    "tsx": "4.23.0",
